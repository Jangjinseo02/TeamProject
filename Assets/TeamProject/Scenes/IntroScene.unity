MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 690263535}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 72eb2308293396e4eb476e6a450c66f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakers:
  - spriteRenderer: {fileID: 1822719118}
    imageDialog: {fileID: 2136210212}
    textName: {fileID: 1751780509}
    textDialogue: {fileID: 792854773}
    objectArrow: {fileID: 2077591155}
  - spriteRenderer: {fileID: 1548948169}
    imageDialog: {fileID: 2136210212}
    textName: {fileID: 1751780509}
    textDialogue: {fileID: 792854773}
    objectArrow: {fileID: 2077591155}
  dialogs:
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uB098\uB294 \uC9C0\uAE08\uAE4C\uC9C0 \uACF5\uBD80\uB97C \uC5F4\uC2EC\uD788
      \uD588\uB2E4.\n\uB300\uAE30\uC5C5\uC5D0 \uC785\uC0AC\uB9CC \uD558\uBA74 \uC778\uC0DD\uC774
      \uD3BC \uC904 \uC54C\uC558\uB2E4."
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uADF8\uB798\uC11C \uC6D0\uC11C\uB97C \uB123\uC5C8\uACE0, \uB5A8\uC5B4\uC84C\uC9C0\uB9CC..."
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uC77C\uC8FC\uC77C \uD6C4 \uADF8\uB7F0\uB370 \uAC11\uC790\uAE30 \uB098\uB97C
      \uCC44\uC6A9\uD558\uACA0\uB2E4\uB294 \uBB38\uC790\uAC00 \uB0A0\uC544\uC654\uB2E4.\n\uAC11\uC791\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC,
      \uBB34\uC2A8 \uC0AC\uC815\uC774 \uC788\uC5C8\uACA0\uC9C0."
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uC624\uB298\uC740 \uB0B4 \uCCAB \uCD9C\uADFC\uB0A0, \uB300\uAE30\uC5C5\uC774\uB2C8\uAE4C
      \uB3C8\uB3C4 \uB9CE\uC774 \uBC8C\uB9B4\uAC70\uC57C.\n\uC55E\uC73C\uB85C \uB0B4
      \uC778\uC0DD\uC740 \uAF43\uAE38\uB9CC \uB0A8\uC558\uB2E4."
  isAutoStart: 1

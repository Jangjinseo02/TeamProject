  - spriteRenderer: {fileID: 1580153151}
    imageDialog: {fileID: 2136210212}
    textName: {fileID: 1751780509}
    textDialogue: {fileID: 792854773}
    objectArrow: {fileID: 2077591155}
  - spriteRenderer: {fileID: 1383271119}
    imageDialog: {fileID: 2136210212}
    textName: {fileID: 1751780509}
    textDialogue: {fileID: 792854773}
    objectArrow: {fileID: 2077591155}
  - spriteRenderer: {fileID: 1687993310}
    imageDialog: {fileID: 2136210212}
    textName: {fileID: 1751780509}
    textDialogue: {fileID: 792854773}
    objectArrow: {fileID: 2077591155}
  - spriteRenderer: {fileID: 1672070103}
    imageDialog: {fileID: 2092770202}
    textName: {fileID: 558151885}
    textDialogue: {fileID: 1187558315}
    objectArrow: {fileID: 376588559}
  - spriteRenderer: {fileID: 1553169907}
    imageDialog: {fileID: 2092770202}
    textName: {fileID: 558151885}
    textDialogue: {fileID: 1187558315}
    objectArrow: {fileID: 376588559}
  - spriteRenderer: {fileID: 1822719118}
    imageDialog: {fileID: 804433784}
    textName: {fileID: 1380745905}
    textDialogue: {fileID: 22261132}
    objectArrow: {fileID: 385626265}
  dialogs:
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "'\uC6B0\uB9AC \uBD80\uC11C\uB294 \uC81C\uD488\uAC1C\uBC1C\uBD80\uC11C\uB2E4.\n\uC5EC\uAE30\uC11C
      \uBC15\uC0AC\uB2D8\uC744 \uAC00\uC7A5 \uBA3C\uC800 \uCC3E\uC544\uAC00\uB77C\uACE0
      \uBB38\uC790\uAC00 \uC654\uB294\uB370...'"
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "'\uD558\uC597\uACE0 \uB098\uC774\uB4DC\uC2E0 \uBD84\uC774 \uBC15\uC0AC\uB2D8\uC778\uAC00
      \uBCF4\uB2E4.\n\uC800\uB807\uAC8C \uB299\uC744\uB54C\uAE4C\uC9C0\uB3C4 \uC77C\uC744
      \uD558\uACE0 \uACC4\uC2DC\uB2E4\uB2C8, \uC798\uB9CC\uD558\uBA74 \uC5EC\uAE30\uC11C
      \uC798\uB9B4 \uC77C\uC740 \uC5C6\uACA0\uB124. '"
  - speakerIndex: 1
    name: "\uB098"
    dialogue: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C! \uC774\uBC88\uC5D0 \uC81C\uD488\uAC1C\uBC1C\uBD80\uC5D0
      \uC0C8\uB85C \uC785\uC0AC\uD558\uAC8C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC798
      \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!"
  - speakerIndex: 5
    name: "\uBC15\uC0AC"
    dialogue: "\uC624\uB298 \uC790\uB124\uAC00 \uC628\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4\uB124,
      \uD658\uC601\uD558\uB124"
  - speakerIndex: 6
    name: "\uC9C1\uC6D0 1"
    dialogue: "'\uAE30\uD569\uC774 \uB4E4\uC5B4\uAC04 \uAC74\uC2E4\uD55C \uCE5C\uAD6C\uAD6C\uB9CC,
      \uB3C4\uC6C0\uC774 \uB418\uACA0\uC5B4'"
  - speakerIndex: 6
    name: "\uC9C1\uC6D0 2"
    dialogue: "'\uADF8\uB7EC\uAC8C, \uADF8\uB798\uB3C4 \uB3C4\uB9DD\uC774\uB098 \uAC00\uC9C0
      \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uB294\uB370...'"
  - speakerIndex: 2
    name: "\uB098"
    dialogue: "(?? \uBB34\uC2A8 \uB9D0\uC744 \uC800\uB807\uAC8C \uD558\uC2DC\uB294\uAC70\uC9C0?
      \uAD1C\uD788 \uB354 \uAE34\uC7A5\uB418\uB124...)"
  - speakerIndex: 4
    name: "\uBC15\uC0AC"
    dialogue: "\uC790\uB124 \uC5B4\uB514 \uC544\uD508\uAC00?\n\uC548\uC0C9\uC774
      \uC88B\uC9C0 \uC54A\uC544 \uBCF4\uC774\uB124\uB9CC..."
  - speakerIndex: 2
    name: "\uB098"
    dialogue: "\uC544.... \uC544\uBB34\uAC83\uB3C4 \uC544\uB2D9\uB2C8\uB2E4.\n\uC5EC\uAE30
      \uBD80\uC11C\uC5D0\uC11C\uB294 \uBB34\uC2A8 \uC77C\uC744 \uD558\uB098\uC694?"
  - speakerIndex: 4
    name: "\uBC15\uC0AC"
    dialogue: "\uC544\uBB34\uB3C4 \uC124\uBA85\uD574 \uC8FC\uC9C0 \uC54A\uC558\uB098
      \uBCF4\uAD6C\uB9CC. \n\uC790\uB124 \uD639\uC2DC \uC774 \uD68C\uC0AC\uC5D0 \uC785\uC0AC\uD55C
      \uC774\uC720\uAC00 \uBB54\uAC00?  "
  - speakerIndex: 1
    name: "\uB098"
    dialogue: "\uC800\uB294 \uC5B4\uB9B4\uC801 \uBD80\uD130 \uC77C\uC0C1\uC744 \uD3B8\uD558\uAC8C
      \uD558\uB294 \uB3C4\uAD6C\uB4E4\uC744 \uB9CC\uB4DC\uB294 \uAC83\uC744 \uC88B\uC544\uD588\uC2B5\uB2C8\uB2E4.
      \uADF8\uB7F0 \uC81C\uD488\uB4E4\uC744 \uC138\uC0C1\uC5D0 \uC120\uBCF4\uC5EC
      \uC138\uC0C1\uC744 \uBC14\uAFD4\uBCF4\uACE0 \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4."
  - speakerIndex: 4
    name: "\uBC15\uC0AC"
    dialogue: "\uC138\uC0C1\uC744 \uBC14\uAFC0 \uC218 \uC788\uB2E4\uBA74 \uBB50\uB4E0\uC9C0
      \uD574\uBCF4\uACA0\uB2E4\uB294 \uB9D0\uB85C \uBC1B\uC544\uB4E4\uC5EC\uB3C4
      \uB418\uB294\uACA0\uC9C0? "
  - speakerIndex: 5
    name: "\uBC15\uC0AC"
    dialogue: "\uADF8\uB807\uB2E4\uBA74 \uCCAB \uCD9C\uADFC\uC5D0 \uB9DE\uB294 \uC77C\uC744
      \uC8FC\uACA0\uB124. \n\uD639\uC2DC \uC800 \uCABD\uC5D0 \uC788\uB294 \uAE30\uACC4\uC704\uC5D0
      \uD55C\uBC88 \uC11C \uC8FC\uACA0\uB098? "
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uB4DC\uB9B4\uACFC \uC548\uC804\uBAA8? \uB3C4\uB300\uCCB4 \uBB34\uC2A8
      \uC77C\uC77C\uAE4C?"
  isAutoStart: 1
